# SMTP Email Notification Credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=agentskaro.noreply@gmail.com
SMTP_PASS=your_gmail_app_password

# From email display name
FROM_EMAIL="AgentsKaro by Yubisaki" <agentskaro.noreply@gmail.com>

# Razorpay (Live Payments)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_key_id

# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key

# Direct .exe Download URL (e.g. GitHub Release binary or direct CDN)
NEXT_PUBLIC_EXE_URL=https://github.com/yubisaki-yat/Agentskaro/releases/download/v1.0.0/AgentsKaro-Setup.exe

# Public app URL
NEXT_PUBLIC_APP_URL=https://agentskaro.co.in
